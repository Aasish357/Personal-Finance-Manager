# Copy this file to .env in the project root, then adjust as needed.
# Every value below is the default the app falls back to if omitted.

# ---- Database: Supabase (Postgres) ----
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
# Transaction pooler (:6543) is the right choice for a long-running API server.
#   postgresql://postgres.PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Keep ?sslmode=require -- Supabase refuses plaintext connections.
DATABASE_URL=postgresql://postgres.PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Use Alembic for the schema on a real database. create_all never alters an
# existing table, so leaving this true would silently skip schema changes.
DB_AUTO_CREATE_TABLES=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Swap back to local SQLite for offline work:
#   DATABASE_URL=sqlite:///./finance.db
#   DB_AUTO_CREATE_TABLES=true

# ---- Backend (app/) ----
SECRET_KEY=dev-secret-key-change-me
CORS_ORIGINS=http://localhost:3000

# ---- AI assistant: local Ollama ----
# Install Ollama from https://ollama.com, then pull the model once:
#   ollama pull llama3:latest
# The assistant uses the rule-based fallback automatically if Ollama is not
# running, so the app works before you set any of this up.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.0

# ---- Frontend (src/) ----
REACT_APP_API_URL=http://localhost:8000/api/v1